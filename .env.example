# Copy to .env and fill in real values. Do not commit .env.

# Frontend (Docusaurus build / local start)
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=tros_doc

# Indexer only (npm run algolia:index)
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SITE_URL=https://developer.d-robotics.cc/tros_doc
ALGOLIA_NO_PROXY=1
